{
  "name": "@aredes.me/mcp-tse",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Brazilian electoral data (TSE Resultados EA20 & Dados Abertos CKAN) with dual Node.js and Cloudflare Workers runtime",
  "type": "module",
  "module": "lib/index.ts",
  "main": "build/lib/adapters/cli.js",
  "bin": {
    "mcp-tse": "build/lib/bin/mcp-tse.js"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "PRIVACY.md",
    ".mcprc.example.json"
  ],
  "scripts": {
    "dev": "tsx lib/adapters/cli.ts",
    "build": "tsc",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start": "node build/lib/adapters/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:transport": "node test/integration/transports.mjs",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "brazil",
    "tse",
    "eleicoes",
    "resultados-tse",
    "dados-abertos",
    "ckan",
    "ea20",
    "apuracao",
    "candidatos",
    "typescript",
    "nodejs",
    "cloudflare-workers",
    "stdio-transport",
    "http-transport"
  ],
  "author": "Cristiano Aredes <cristiano@aredes.me>",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianoaredes/mcp-tse.git"
  },
  "bugs": {
    "url": "https://github.com/cristianoaredes/mcp-tse/issues"
  },
  "homepage": "https://github.com/cristianoaredes/mcp-tse#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^5.6.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
